theme_override_font_sizes/italics_font_size = 31
theme_override_font_sizes/mono_font_size = 31
theme_override_styles/normal = SubResource("StyleBoxFlat_y6s48")
bbcode_enabled = true
text = "So how do you win in the arena? Simply by not losing. So how do you lose?

First, never let your gladiator die. If their [color=\"79444a\"]Health[/color] drops below zero, you’ll be punished heavily. To reduce incoming damage, adjust your [color=\"c77b58\"]concede threshold[/color] based on how hard you expect the opponent to strike. You decide how risky you want to be with your gladiator.

You can also lose if your gladiator doesn’t have enough [color=\"d2b600\"]Endurance[/color] and collapses from exhaustion. A fighter who can’t stay standing can’t win, no matter how strong they are."
autowrap_mode = 2
horizontal_alignment = 1
vertical_alignment = 1


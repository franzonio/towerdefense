theme_override_font_sizes/font_size = 31
theme_override_styles/normal = SubResource("StyleBoxFlat_y6s48")
text = "You see them every day in the slave market. Each one carries a story about how they ended up here. The thin Elf was likely taken by raiders, the trembling Human caught stealing from a sacred shrine, and the massive Troll sold himself to escape a life already broken long before chains.

But their pasts mean nothing to you. As a Lanista, you care only about the potential buried beneath fear, hunger, and inexperience. These untrained slaves are raw material - and you know how to forge them into champions.

You understand the strengths and weaknesses of every race. Your job is to shape them. Train them with purpose, equip them wisely, and craft the combat strategies that will win the crowd. In the arena, glory belongs to the gladiator - but their success begins with you."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2


theme_override_font_sizes/mono_font_size = 31
theme_override_styles/normal = SubResource("StyleBoxFlat_y6s48")
bbcode_enabled = true
text = "Each race has with their own unique characteristics. 

[color=\"ba9158\"]Humans[/color] are the jack of all trades. You can train them to become any kind of gladiator you want. They adapt quickly and rarely disappoint.

[color=\"b3a555\"]Elves[/color] are virtuosos of agility and weapon mastery, but fragile and demand careful handling. When trained well, they typically win through finesse rather than brute force.

[color=\"ae5d40\"]Orcs[/color] are strong, tough and quick weapon learners, but below average in terms of agility.

[color=\"726566\"]Trolls[/color] rely on their brutal physique. With their low intellect it's hard, but not impossible, to teach them other methods to win in the arena."
autowrap_mode = 2
horizontal_alignment = 1
vertical_alignment = 1


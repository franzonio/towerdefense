bbcode_enabled = true
text = "The three main sources of [color=\"cd8900\"]attributes[/color] are 
1) buying attribute cards
2) leveling up your gladiator
3) equipping items

Note: attributes from equipped items are not affected by race modifiers!


Your gladiator's attributes will also permanently adjust as they [color=\"ba9158\"]age[/color]. Their power increases as they transition from being [color=\"ba9158\"]young[/color] to [color=\"ba9158\"]adult[/color], while it decreases later in life when becoming [color=\"ba9158\"]aged[/color] and eventually [color=\"ba9158\"]old[/color]."
autowrap_mode = 2
horizontal_alignment = 1
vertical_alignment = 1


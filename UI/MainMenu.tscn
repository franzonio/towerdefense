theme_override_styles/normal = SubResource("StyleBoxFlat_y6s48")
bbcode_enabled = true
text = "Weapons and shields have [color=\"03877d\"]durability[/color]. When an incoming hit is parried or blocked, damage goes to the item instead of your gladiator.

If durability reaches zero the item is [color=\"847875\"]destroyed[/color] and your gladiator must continue to fight with their bare fist. It is therefore of utmost importance to balance weapon mastery training wisely.


Luckily the weaponsmiths of the Arena will happily repair the items after the combat, free of charge."
autowrap_mode = 2
horizontal_alignment = 1
vertical_alignment = 1

